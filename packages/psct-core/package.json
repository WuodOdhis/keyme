{
  "name": "@keyme/psct-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PSCT core: molecule, sighash, proof binding, inspect, verify.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/hostile.test.ts src/psct.test.ts && tsx src/scripts/offline.ts",
    "vectors": "tsx src/scripts/make-vectors.ts",
    "conformance": "tsx src/scripts/conformance.ts",
    "selftest": "tsx src/scripts/selftest.ts",
    "collect": "tsx src/scripts/collect.ts",
    "redteam": "tsx src/scripts/redteam.ts",
    "devnet:multisig": "tsx src/scripts/devnet-multisig.ts",
    "inspect": "tsx src/cli.ts inspect",
    "verify": "tsx src/cli.ts verify"
  },
  "dependencies": {
    "@noble/curves": "1.4.0",
    "@noble/hashes": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
